# Cyber Sentinel AI — Environment Configuration
# Copy this file to .env and fill in your actual values.
# This file is committed to Git as an example — .env is NOT committed (add to .gitignore)

# Required: Google Gemini API Key (get one free at https://aistudio.google.com/apikey)
# The key lives ONLY here on the backend. Never put it in the React frontend.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini model to use (default: gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# Optional: ML API URL (default: http://localhost:8000)
ML_API_URL=http://localhost:8000
